        <!-- Extraction internal -->
        <mxCell id="e-cit-domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C2410C;strokeWidth=1;endArrow=block;" edge="1" source="ex-cit" target="ex-domain" parent="1">
          <mxGeometry relative="1" as="geometry" />
