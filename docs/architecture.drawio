        <mxCell id="e-claim-vault" value="match facts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CA8A04;strokeWidth=1;dashed=1;endArrow=block;fontSize=10;fontColor=#000000;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="ex-claim" target="k-vault" parent="1">
