        <mxCell id="e-studio-pub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BE185D;strokeWidth=1;dashed=1;endArrow=open;" edge="1" source="sc-studio" target="out-publish" parent="1">
