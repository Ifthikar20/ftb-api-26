          <mxGeometry x="40" y="1880" width="2520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d-pg" value="Postgres + pgvector&#10;tenant data · audits · results · prompts · facts · citations · embeddings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="1925" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d-redis" value="Redis&#10;Celery broker · cache · channels layer" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="610" y="1925" width="380" height="70" as="geometry" />
