        <!-- Audit → Extraction -->
        <mxCell id="e-audit-ext" value="step D: parallel extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C2410C;strokeWidth=2;endArrow=block;fontSize=10;fontColor=#000000;" edge="1" source="grp-audit" target="grp-ext" parent="1">
          <mxGeometry relative="1" as="geometry" />
