        <!-- Result → WS -->
        <mxCell id="e-res-ws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0E7490;strokeWidth=1;endArrow=block;" edge="1" source="ar-result" target="ar-ws" parent="1">
          <mxGeometry relative="1" as="geometry" />
