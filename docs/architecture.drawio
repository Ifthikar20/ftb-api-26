        <!-- Scoring → Delivery -->
        <mxCell id="e-score-out" value="step F: deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4338CA;strokeWidth=2;endArrow=block;fontSize=10;fontColor=#000000;" edge="1" source="grp-score" target="grp-out" parent="1">
