        <mxCell id="e-rt-google" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B91C1C;strokeWidth=1;dashed=1;endArrow=open;" edge="1" source="ar-router" target="ar-google" parent="1">
