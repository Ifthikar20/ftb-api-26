        <mxCell id="e-claim-mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#CA8A04;strokeWidth=1;dashed=1;endArrow=block;" edge="1" source="ex-claim" target="ex-mismatch" parent="1">
          <mxGeometry relative="1" as="geometry" />
