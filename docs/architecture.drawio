        <mxCell id="d-bedrock" value="Bedrock / OpenSearch / Iceberg&#10;[Phase 5 — when scale demands]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;dashed=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="2120" y="1925" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- Celery infra mini -->
        <mxCell id="grp-celery" value="ASYNC INFRA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#15803D;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#000000;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2060" width="2520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ce-workers" value="Celery workers&#10;default · ai · integrations · webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="2105" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ce-beat" value="Celery beat&#10;mine-prompts · compute-source-influence · classify-domains · weekly reports · audit dispatcher · token refresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="610" y="2105" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ce-ext" value="Outbound integrations (egress NAT)&#10;Stripe · Reddit · SerpAPI · OAuth (Google/Meta/LinkedIn/Shopify) · SendGrid/Slack/Discord/Telegram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1540" y="2105" width="980" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="LEGEND&#10;Solid green = shipped (Phases 1 + 2)&#10;Dashed yellow = Phase 3 (Brand Vault + Claim Verification)&#10;Dashed pink = Phase 4 (Content Studio)&#10;Dashed blue = Phase 5 (AWS scale)&#10;Red ellipse = External provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=11;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="2220" width="600" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES (flow direction) ===================== -->

