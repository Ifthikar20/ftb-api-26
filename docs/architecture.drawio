        <mxCell id="d-s3" value="S3 / object storage&#10;raw LLM payloads · scraped HTML · cited-page snapshots [TODO]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;dashed=1;fontColor=#000000;" vertex="1" parent="1">
