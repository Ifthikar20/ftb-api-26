        <mxCell id="e-store-sampler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7E22CE;strokeWidth=1;endArrow=block;" edge="1" source="pr-store" target="pr-sampler" parent="1">
          <mxGeometry relative="1" as="geometry" />
