# ═══════════════════════════════════════════════════════
#  FetchBot — Production Environment Variables
#  Copy to .env.prod and fill in real values
# ═══════════════════════════════════════════════════════

# ── Django ──
DJANGO_SECRET_KEY=CHANGE_ME_USE_50_CHAR_RANDOM_STRING
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
ALLOWED_HOSTS=fetchbot.ai,www.fetchbot.ai

# ── Database (internal Docker network) ──
DB_NAME=growthpilot
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ── Redis (internal Docker network) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── JWT ──
JWT_SIGNING_KEY=CHANGE_ME_USE_64_CHAR_RANDOM_STRING

# ── Field Encryption ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://fetchbot.ai,https://www.fetchbot.ai

# ── LLM Providers (REQUIRED — audits run against all four) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# Enable web-search tools on Claude/GPT/Gemini/Grok so they answer as a
# local user for the selected region (Perplexity is always web-grounded).
# Costs more per call. Default off.
LLM_WEBSEARCH_ENABLED=false

# ── DeepSeek (tooling only) ──
# Used for offline work: prompt synthesis, auto-templating, smoke tests.
# NEVER used to answer real audit prompts. Leave blank to fall back to
# Anthropic for synthesis. ~30x cheaper per call when configured.
DEEPSEEK_API_KEY=
PROMPT_SYNTHESIS_PROVIDER=deepseek

# ── Search-source lookup (Source Influence "Who's asking") ──
# Powers the live Google search panel inside the Prompt Library detail
# drawer. Without it, the panel shows an "add a key" message; everything
# else still works.
SERPAPI_KEY=

# ── Phase 2/3/4 feature flags (default True; set False to disable) ──
# Citation extraction runs after every audit result is persisted.
CITATION_EXTRACTION_ENABLED=True
# Claim extraction + Brand Vault fact extraction run during audits.
CLAIM_VERIFICATION_ENABLED=True
BRAND_VAULT_EXTRACTION_ENABLED=True
# Content Studio brief generation fires after each audit completes.
CONTENT_STUDIO_BRIEF_GENERATION_ENABLED=True
# Live publishing makes real HTTP calls to WP/Webflow/Shopify/HubSpot.
# Keep False until the tenant's publish targets are configured + tested.
CONTENT_STUDIO_PUBLISH_LIVE=False

# ── Billing ──
# Paywall is OFF by default: users are never routed to /paywall and all
# plan-entitlement checks pass as the top tier. Set to True when billing
# goes live to restore the paywall and plan gating.
PAYWALL_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_SCALE_ANNUAL_PRICE_ID=

# ── Other integrations ──
SENDGRID_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SENTRY_DSN=

# ── Google Search Console ──
# Reuses GOOGLE_OAUTH_CLIENT_ID/SECRET. The redirect URI must be added
# to the Google Cloud OAuth client's authorized redirect URIs, and the
# consent screen must include the webmasters.readonly scope.
FRONTEND_URL=https://fetchbot.ai
GSC_OAUTH_REDIRECT_URI=https://fetchbot.ai/api/v1/search-console/oauth/callback/
GSC_DAILY_ROW_LIMIT=5000
GSC_BACKFILL_DAYS=28
GSC_SYNC_LOOKBACK_DAYS=7
GSC_RETENTION_DAYS=480
GSC_DAILY_API_LIMIT_PER_USER=2000
GSC_PROMPT_MIN_IMPRESSIONS=10
GSC_PROMPT_TOP_N=50
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── AWS S3 (for media/static storage) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=fetchbot-assets
AWS_S3_REGION_NAME=us-east-1

# ── OpenClaw AI Agent (self-hosted) ──
OPENCLAW_GATEWAY_URL=http://openclaw:18789
OPENCLAW_AUTH_TOKEN=CHANGE_ME_RANDOM_TOKEN

# ── Email ──
OPS_EMAIL=ops@fetchbot.ai
SERVER_EMAIL=noreply@fetchbot.ai
YELP_API_KEY=
